{
  "name": "smartfarm",
  "version": "0.1.0-scaffold",
  "private": true,
  "description": "SmartFarm Dairy Management System - architecture-compliant scaffold. No application features implemented.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @smartfarm/web",
    "dev:api": "npm run dev --workspace @smartfarm/api",
    "dev:worker": "npm run dev --workspace @smartfarm/worker",
    "build": "npm run build --workspace @smartfarm/web && npm run build --workspace @smartfarm/api && npm run build --workspace @smartfarm/worker",
    "typecheck": "tsc --noEmit --project tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "preview": "vite preview --config vite.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}

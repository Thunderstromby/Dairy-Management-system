# SmartFarm Environment Configuration
APP_NAME=smartfarm
APP_URL=http://localhost:3000
NODE_ENV=development

# Backend
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=smartfarm
DB_USERNAME=smartfarm
DB_PASSWORD=changeme

# Auth
SESSION_SECRET=change-this-to-a-strong-random-value
SESSION_COOKIE_NAME=smartfarm.sid
SESSION_MAX_AGE=86400

# Argon2id
ARGON2ID_MEMORY=65536
ARGON2ID_TIME=3
ARGON2ID_THREADS=2

# Graphile Worker
WORKER_CONNECTION_STRING=postgres://smartfarm:changeme@localhost:5432/smartfarm

# Brevo (Transactional Email)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_NAME=SmartFarm <no-reply@smartfarm.local>
BREVO_SENDER_EMAIL=no-reply@smartfarm.local

# Storage (OCI)
STORAGE_PROVIDER=oci
STORAGE_BUCKET=smartfarm-attachments